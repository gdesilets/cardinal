# Raw Discord scrapes + database-build pipeline: local-only, not part of the shipped
# skill, regeneratable. See pipeline/README.md. Only the finished skill folders
# (.claude/skills/, .codex/skills/) are tracked.
/pipeline/

# Python-generated caches
__pycache__/
*.py[cod]

# SQLite runtime sidecars; the database files themselves are versioned through LFS.
*.sqlite-shm
*.sqlite-wal

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.tmp

# Personal, per-machine Claude Code settings (permissions etc.), not project config.
.claude/settings.local.json
